%% CPM Figure (d)
% Compute Network Strength

clear; clc;

%% Load FC
load('C:\Users\june0\Downloads\ADHD200_Athena_CC200_FC.mat',...
    'FC_all','subject_ID');

%% Load selected edges
load('C:\Users\june0\Downloads\ADHD200_CPM_BC_zscore.mat',...
    'edge_index',...
    'positive_edges',...
    'negative_edges');

%% Load behavior
T = readtable(...
'C:\Users\june0\Downloads\ADHD200_Athena_CC200_final_subjects_z.csv',...
'VariableNamingRule','preserve');

behavior = T.Inattentive_z;

%% Sizes
[nROI,~,N] = size(FC_all);

fprintf("Subjects : %d\n",N);

%% FC -> edge matrix
FC2 = reshape(FC_all,nROI*nROI,N);

edge_data = FC2(edge_index,:);

fprintf("Edge matrix : %d x %d\n",...
    size(edge_data,1),...
    size(edge_data,2));

%% Positive network strength
positive_strength = ...
    sum(edge_data(positive_edges,:),1)';

%% Negative network strength
negative_strength = ...
    sum(edge_data(negative_edges,:),1)';

%% Combined network
combined_strength = ...
    positive_strength - negative_strength;

%% Display
fprintf("\nNetwork strength complete\n");

fprintf("\nPositive\n");
fprintf("Mean %.3f\n",mean(positive_strength));
fprintf("SD   %.3f\n",std(positive_strength));

fprintf("\nNegative\n");
fprintf("Mean %.3f\n",mean(negative_strength));
fprintf("SD   %.3f\n",std(negative_strength));

%% Save
save(...
'C:\Users\june0\Downloads\ADHD200_CPM_D_network_strength.mat',...
'positive_strength',...
'negative_strength',...
'combined_strength',...
'behavior',...
'subject_ID');

%% CSV

Result = table(...
subject_ID,...
behavior,...
positive_strength,...
negative_strength,...
combined_strength,...
'VariableNames',...
{'SubjectID',...
'Behavior',...
'PositiveStrength',...
'NegativeStrength',...
'CombinedStrength'});

writetable(Result,...
'C:\Users\june0\Downloads\ADHD200_CPM_D_network_strength.csv');

fprintf("\nSaved.\n");
